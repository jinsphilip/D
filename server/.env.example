# Copy this file to .env (in this same server/ folder) and fill in your
# real values. .env is gitignored — never commit your actual credentials.

# MongoDB Atlas: Database -> Connect -> Drivers -> copy the connection
# string, then replace <password> with your database user's real password.
# The database name itself doesn't need to be in this URI — the server
# always uses a fixed database ("nep_payroll") regardless.
#
# Don't forget: Atlas -> Network Access -> Add IP Address -> Allow Access
# From Anywhere (0.0.0.0/0). Render's outbound IP isn't fixed on the free
# plan, so without this the server can't reach the database at all.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Login credentials, used ONLY the very first time the app boots with no
# login configured yet — that's when these get saved as the app's one
# shared login. After that first boot, these two vars are no longer read;
# change the password from the Settings screen inside the app instead.
# Pick your own values — these are just the bootstrap default.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-boot

# Any long random string, used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this later invalidates all existing sessions (everyone gets
# logged out) — not harmful, just something to know if it happens.
SESSION_SECRET=replace-with-a-long-random-string

# Uncomment to skip the login screen entirely — every request is treated as
# already authenticated. For local troubleshooting only (e.g. locked out
# after a password/DB mismatch). NEVER set this on Render or anywhere else
# reachable by other people.
# BYPASS_AUTH=true
