# Copy this file to .env (in this same server/ folder) and fill in your
# real database connection string. .env is gitignored — never commit your
# actual credentials.
#
# Supabase: Project Settings -> Database -> Connection string -> URI tab
# (use the "Transaction pooler", port 6543, not the direct connection)
#
# Render Postgres: the database's "Internal Database URL" (if the web
# service and database are both on Render) or "External Database URL"
# (if connecting from anywhere else, e.g. your own machine)
DATABASE_URL=postgresql://user:password@host:5432/dbname
